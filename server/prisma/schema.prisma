// Dinovo — restaurant host-stand & reservation management
// Prisma schema (Postgres)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  ADMIN
  MANAGER
  HOST
}

enum TableShape {
  ROUND
  SQUARE
  RECTANGLE
}

enum TableStatus {
  OPEN
  SEATED
  ORDERED
  NEEDS_CLEANING
}

enum ReservationStatus {
  BOOKED
  SEATED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum WaitlistStatus {
  WAITING
  SEATED
  CANCELLED
}

// ---------- Models ----------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(HOST)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdReservations Reservation[] @relation("ReservationCreatedBy")
  createdTableBlocks  TableBlock[]  @relation("TableBlockCreatedBy")

  @@map("users")
}

// Named floor areas (Patio, Bar, Main Dining, ...) a table can belong to. Optional — a table
// with no section just shows up under "All tables".
model Section {
  id        String   @id @default(uuid())
  name      String   @unique
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tables RestaurantTable[]

  @@map("sections")
}

// The floor plan. "RestaurantTable" avoids clashing with the SQL keyword TABLE.
model RestaurantTable {
  id              String      @id @default(uuid())
  number          Int         @unique
  capacity        Int
  shape           TableShape  @default(SQUARE)
  positionX       Float       @default(0)
  positionY       Float       @default(0)
  status          TableStatus @default(OPEN)
  // Set explicitly whenever `status` changes (not on every edit — repositioning a table during
  // layout work shouldn't reset how long it's been "Seated"). Powers the live elapsed-time badge
  // and the Currently Seated panel.
  statusUpdatedAt DateTime    @default(now())
  sectionId       String?
  section         Section?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  reservations     Reservation[]
  waitlistSeatings WaitlistEntry[]
  combinations     TableCombination[] @relation("CombinationTables")
  blocks           TableBlock[]

  @@map("restaurant_tables")
}

model Guest {
  id                  String   @id @default(uuid())
  firstName           String
  lastName            String
  phone               String?
  email               String?
  visitCount          Int      @default(0)
  // Incremented on the transition into NO_SHOW, mirroring how visitCount tracks COMPLETED —
  // see server/src/routes/reservations.ts.
  noShowCount         Int      @default(0)
  // Incremented on the transition into CANCELLED, same pattern as noShowCount.
  cancellationCount   Int      @default(0)
  tags                String[] @default([])
  // System-computed tags (e.g. "Regular", "Lapsing" — see server/src/lib/guestTags.ts), kept
  // separate from the manually-edited `tags` above so a host un-tagging something manual is
  // never re-applied by the next automated pass, and an auto-tag disappearing never touches a
  // host's manual tags. The UI merges both for display with a visual distinction.
  autoTags            String[] @default([])
  notes               String?  @db.Text
  // Short label (e.g. "Anniversary") plus a month/day-only date ("MM-DD" — no year, since we
  // don't need one to remind a host it's coming up every year).
  specialOccasion     String?
  specialOccasionDate String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  reservations Reservation[]

  // Guests are commonly looked up by phone/email at the host stand.
  @@index([phone])
  @@index([email])
  @@map("guests")
}

model Shift {
  id           String   @id @default(uuid())
  name         String
  dayOfWeek    Int // 0 = Sunday .. 6 = Saturday
  // Stored as minutes-from-midnight so pacing/time-slot math is plain integer arithmetic.
  startMinutes Int
  endMinutes   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pacingRules  PacingRule[]
  turnTimes    TurnTime[]
  reservations Reservation[]

  @@index([dayOfWeek])
  @@map("shifts")
}

model PacingRule {
  id              String   @id @default(uuid())
  shiftId         String
  shift           Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  // Start of the time slot this rule governs, minutes-from-midnight (e.g. 18:00 = 1080).
  timeSlotMinutes Int
  maxCovers       Int
  maxPartySize    Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([shiftId, timeSlotMinutes])
  @@map("pacing_rules")
}

// How long a party occupies a table, by party size: "parties of up to `maxPartySize` take
// `minutes`". Rules with a shiftId override the house defaults (shiftId null) for that shift — a
// shift with any rules of its own uses only those. See server/src/lib/turnTimes.ts for the lookup.
model TurnTime {
  id           String   @id @default(uuid())
  shiftId      String?
  shift        Shift?   @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  maxPartySize Int
  minutes      Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Postgres treats NULLs as distinct, so this only guards per-shift rules; the route enforces
  // uniqueness for house defaults (shiftId null).
  @@unique([shiftId, maxPartySize])
  @@map("turn_times")
}

// A predefined set of tables pushed together for a large party (e.g. T4 + T5 seat 10). A
// reservation assigned to a combination occupies every member table.
model TableCombination {
  id        String   @id @default(uuid())
  capacity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tables       RestaurantTable[] @relation("CombinationTables")
  reservations Reservation[]

  @@map("table_combinations")
}

// A table held out of service for a time range (VIP hold, maintenance, private event). Blocks
// conflict with reservations exactly like another booking would.
model TableBlock {
  id          String          @id @default(uuid())
  tableId     String
  table       RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  endsAt      DateTime
  reason      String?
  createdById String?
  createdBy   User?           @relation("TableBlockCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([tableId, startsAt])
  @@map("table_blocks")
}

model Reservation {
  id        String            @id @default(uuid())
  guestId   String
  guest     Guest             @relation(fields: [guestId], references: [id])
  partySize Int
  dateTime  DateTime
  status    ReservationStatus @default(BOOKED)
  tableId   String?
  table     RestaurantTable?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  // Set when the party is booked on a TableCombination; `tableId` then holds the combination's
  // lowest-numbered table, so everything that shows "Table N" keeps working.
  combinationId String?
  combination   TableCombination? @relation(fields: [combinationId], references: [id], onDelete: SetNull)
  // Host override of how long this party holds the table (e.g. resized on the grid view). Null
  // means "use the TurnTime rule for this party size and shift".
  durationMinutes Int?
  shiftId   String?
  shift     Shift?            @relation(fields: [shiftId], references: [id])
  // Per-visit occasion tags (e.g. "Anniversary", "Date Night") — separate from the guest-level
  // Guest.tags above, which describe the person rather than this one visit.
  tags      String[]          @default([])
  // Replaces the old single `notes` field with OpenTable-style structured note fields. See
  // migration 20260924000000_reservation_detail_fields for the notes -> generalNote backfill.
  generalNote   String? @db.Text
  offerNote     String? @db.Text
  foodDrinkNote String? @db.Text
  seatingNote   String? @db.Text
  // When true, this reservation's covers are excluded from its slot's PacingRule.maxCovers check
  // (client lib/pacing.ts, server lib/pacing.ts) — a host's escape hatch for a party pacing
  // shouldn't block (a VIP, a comp'd table) without having to raise the whole slot's cap.
  excludeFromPacing Boolean @default(false)
  seatedAt    DateTime?
  completedAt DateTime?
  createdById String?
  createdBy   User?             @relation("ReservationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // The day-view timeline and pacing checks both filter/sort by time.
  @@index([dateTime])
  @@index([tableId])
  @@index([guestId])
  @@index([combinationId])
  @@map("reservations")
}

model WaitlistEntry {
  id                String           @id @default(uuid())
  guestName         String
  phone             String?
  partySize         Int
  quotedWaitMinutes Int
  status            WaitlistStatus   @default(WAITING)
  seatedTableId     String?
  seatedTable       RestaurantTable? @relation(fields: [seatedTableId], references: [id], onDelete: SetNull)
  addedAt           DateTime         @default(now())
  seatedAt          DateTime?
  updatedAt         DateTime         @updatedAt

  @@index([status])
  @@map("waitlist_entries")
}
